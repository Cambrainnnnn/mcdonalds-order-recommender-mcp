# Copy this file to .env, replace all placeholder secrets, then start the
# Hermes stack with: docker compose -f compose.hermes.yaml up -d --build
POSTGRES_PASSWORD=replace-with-random-hex
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=replace-with-random-hex
HERMES_DASHBOARD_SECRET=replace-with-random-hex
HERMES_API_SERVER_KEY=replace-with-random-hex

HERMES_MODEL_PROVIDER=deepseek
HERMES_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

APP_MCD_MCP_ENDPOINT=https://mcp.mcd.cn
APP_MCD_MCP_TOKEN=
HERMES_HOST_BIND=127.0.0.1
HERMES_IMAGE=nousresearch/hermes-agent:latest
GO_IMAGE=golang:1.25-alpine
